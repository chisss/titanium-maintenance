<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.titanium</groupId>
        <artifactId>titanium-maintenance</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>titanium-maintenance-api</artifactId>
    <name>titanium-maintenance-api</name>
    <description>保全服务API模块</description>

    <dependencies>
        <!-- PKG-02 契约层自包含白名单：仅 metadata（共享内核）+ 契约注解 -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-metadata</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-openfeign-core</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <!-- PKG-02：契约层依赖白名单门禁（规则见 titanium-parent pluginManagement）。
                 本模块不是领域层，禁用 ban-frameworks-in-domain（契约本就使用 spring-web/Feign 注解）；
                 同时按 id 覆盖启用 api-dependency-whitelist（父 POM 默认 phase=none，防非 api 模块误伤） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>ban-frameworks-in-domain</id>
                        <phase>none</phase>
                    </execution>
                    <execution>
                        <id>api-dependency-whitelist</id>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>