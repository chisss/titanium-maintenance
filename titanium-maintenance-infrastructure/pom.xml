<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>titanium-maintenance</artifactId>
        <groupId>com.titanium</groupId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>titanium-maintenance-infrastructure</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <dependencies>
        <!-- Domain Module -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-maintenance-domain</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Common Module -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-maintenance-common</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- 通用内核：死信指标装饰器 DltMetricsRecoverer 所在模块（G16 跨域 Kafka 死信可见性） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-common</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- 死信投递指标：DltMetricsRecoverer 直接引用 MeterRegistry（编译期类型）；
             运行时 registry 由 bootstrap 的 actuator/prometheus 提供，版本由 Boot BOM 管理 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <!-- Jackson JSR-310：Kafka 事件序列化 LocalDateTime 所需 -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Axon Framework (axon-spring-boot-starter 已内置 JPA 事件存储) -->
        <dependency>
            <groupId>org.axonframework</groupId>
            <artifactId>axon-spring-boot-starter</artifactId>
        </dependency>

        <!-- Spring Cloud OpenFeign (PolicyServiceClient/CustomerServiceClient) -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>

        <!-- customer-api：复用 CustomerResponseDTO 作为 CustomerServiceClient 响应类型，防止契约漂移 -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-customer-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- policy-api：复用统一响应封装与 Policy DTO，防止自维护 Feign 镜像漂移 -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-policy-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Product/Billing API：保全生命周期计价编排只依赖对外契约，不依赖外域实现 -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-product-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-billing-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-payment-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-claim-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-underwriting-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-investment-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <!-- rule-engine-api：保全配置规则权威（AC-03）与字段条件规则求值（AC-04）复用对端契约 DTO -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-rule-engine-api</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- FastJSON2 -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
        </dependency>

        <!-- 测试依赖（版本由 parent 管理） -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
