<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.titanium</groupId>
        <artifactId>titanium-maintenance</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>titanium-maintenance-bootstrap</artifactId>
    <name>titanium-maintenance-bootstrap</name>
    <description>保全服务启动模块</description>

    <dependencies>
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-maintenance-web</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-maintenance-infrastructure</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <!-- Query Module（CQRS 读侧：读模型投影 + 查询处理 + DLQ） -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-maintenance-query</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ============ 架构守护测试（仅 test 作用域，不进运行时） ============ -->
        <!-- 共享 ArchUnit 基类制品：提供 AbstractArchitectureGuardTest -->
        <dependency>
            <groupId>com.titanium</groupId>
            <artifactId>titanium-build-tools</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchUnit：以 JUnit 测试形式校验 CLAUDE.md 的分层/命名/依赖约束（版本由 parent 管理） -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>